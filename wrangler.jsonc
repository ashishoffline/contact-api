{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contact-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "contact-api.ashishjha.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  }
}